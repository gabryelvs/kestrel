  "guide": {
    "vendor": "asus",
    "board": "ROG MAXIMUS XIII HERO",
    "enterKey": "Del",
    "tip": "Press F7 to switch between EZ Mode and Advanced Mode. The Search button at the top finds any setting by name.",
    "sections": [
      {
        "topic": "xmp",
        "title": "Turn on XMP",
        "why": "Most RAM starts at a safe, slow default speed. XMP runs it at the speed on the box, which can add a lot of FPS in CPU-heavy games like VALORANT.",
        "steps": [
          "Restart and press Del to open the BIOS.",
          "Press F7 for Advanced Mode.",
          "Open the Extreme Tweaker tab.",
          "Set Ai Overclock Tuner to XMP I.",
          "Check that DRAM Frequency shows your kit's speed, then press F10 and choose Yes."
        ],
        "caution": "If the PC won't start, it usually retries with safe settings by itself. If it doesn't, clear the BIOS settings (Clear CMOS) and try a lower speed.",
        "link": null
      },
      {
        "topic": "memory-gear",
        "title": "Keep the memory controller in Gear 1",
        "why": "On 11th-gen Intel CPUs, Gear 1 runs the memory controller at full speed. Gear 2 adds delay that usually costs more FPS than the extra RAM speed gains.",
        "steps": [
          "On the Extreme Tweaker tab, set Memory Controller : DRAM Frequency Ratio to 1:1.",
          "If the PC is unstable at your kit's speed in 1:1, set DRAM Frequency to DDR4-3200 and keep 1:1.",
          "Press F10 and choose Yes."
        ],
        "caution": "Crashes or blue screens after this change mean the memory can't hold that speed in Gear 1. Lower the frequency.",
        "link": null
      },
      {
        "topic": "update-bios",
        "title": "Update the BIOS",
        "why": "Riot has asked some players to install BIOS updates released after December 2025 to fix a security flaw. Updates also improve memory compatibility.",
        "steps": [
          "Download the latest BIOS for ROG MAXIMUS XIII HERO from ASUS support and copy it to a USB stick.",
          "In the BIOS, open Tool → ASUS EZ Flash 3 Utility.",
          "Pick the file on the USB stick and confirm."
        ],
        "caution": "Don't turn off the PC while it updates. Updating resets BIOS settings, so turn XMP back on afterwards.",
        "link": {
          "label": "Open ASUS support",
          "url": "https://www.asus.com/support/download-center/"
        }
      },
      {
        "topic": "iommu",
        "title": "Turn on IOMMU (only if you need it)",
        "why": "Vanguard's optional On-Demand mode needs it, and Riot can ask for it on some accounts. It doesn't change FPS.",
        "steps": [
          "Press F7 for Advanced Mode.",
          "Open Advanced → System Agent (SA) Configuration.",
          "Set VT-d to Enabled.",
          "Press F10 and choose Yes."
        ],
        "caution": "Menu names vary between boards and BIOS versions. If you can't find it, search the BIOS for VT-d or IOMMU.",
        "link": null
      },
      {
        "topic": "resizable-bar",
        "title": "Resizable BAR (optional)",
        "why": "Lets the CPU reach all of the graphics card's memory at once. VALORANT gains little, but some other games do.",
        "steps": [
          "Press F7 for Advanced Mode.",
          "Open Advanced → PCI Subsystem Settings.",
          "Set Above 4G Decoding to Enabled, then Re-Size BAR Support to Auto.",
          "Press F10 and choose Yes."
        ],
        "caution": "Windows must start in UEFI mode (CSM off) for this to work.",
        "link": null
      }
    ]
  }
